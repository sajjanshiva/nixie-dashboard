# Copy this file to .env and fill in real values.
# See README.md for where to get each key.

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase ---
# Project URL is the same as the client's VITE_SUPABASE_URL.
SUPABASE_URL=
# Service role key — Project Settings -> API -> "service_role" secret.
# NEVER expose this in the frontend. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# --- First admin account (created once, on `npm run seed:admin`) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Office attendance geofence ---
OFFICE_LAT=
OFFICE_LNG=
OFFICE_RADIUS_METERS=120
OFFICE_START_TIME=09:30

# --- ImageKit (receipt uploads) ---
# Dashboard -> Developer options
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Shopify ---
# Custom app (Shopify Admin -> Settings -> Apps -> Develop apps)
# Admin API access token, scopes: read_orders, read_customers, read_products
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
# Webhook signing secret shown when you create the webhook subscription
SHOPIFY_WEBHOOK_SECRET=

# --- WhatsApp Business Cloud API (Meta) ---
# developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v19.0
