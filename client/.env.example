# Copy this file to .env and fill in real values.
# See README.md at the end of setup for where to get each key.

# --- Supabase (database + auth + realtime) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- ImageKit (receipt image uploads) ---
VITE_IMAGEKIT_URL_ENDPOINT=
VITE_IMAGEKIT_PUBLIC_KEY=

# --- Backend API (built in stage 2 — Express server) ---
# This is where messages get sent (so WhatsApp/Shopify secrets never
# reach the browser), and where attendance check-in is validated.
VITE_API_BASE_URL=http://localhost:5000
